{
  "name": "Depoimento",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "title": "Nome completo"
    },
    "idade": {
      "type": "number",
      "title": "Idade"
    },
    "curso": {
      "type": "string",
      "title": "Curso conclu\u00eddo"
    },
    "ano_conclusao": {
      "type": "number",
      "title": "Ano de conclus\u00e3o"
    },
    "cidade_estado": {
      "type": "string",
      "title": "Cidade e Estado"
    },
    "texto_conciliar": {
      "type": "string",
      "title": "Como foi conciliar trabalho, fam\u00edlia e estudos"
    },
    "texto_apos": {
      "type": "string",
      "title": "O que aconteceu ap\u00f3s a conclus\u00e3o"
    },
    "contribuicao_projetos": {
      "type": "string",
      "title": "Contribui\u00e7\u00e3o para projetos de vida",
      "enum": [
        "Sim, muito",
        "Sim, parcialmente",
        "Pouco",
        "Ainda estou construindo esse caminho"
      ]
    },
    "situacao_atual": {
      "type": "array",
      "title": "Situa\u00e7\u00e3o ap\u00f3s o curso",
      "items": {
        "type": "string"
      }
    },
    "mensagem": {
      "type": "string",
      "title": "Mensagem para quem est\u00e1 estudando hoje"
    },
    "texto": {
      "type": "string",
      "title": "Depoimento (campo legado)"
    },
    "autorizado": {
      "type": "boolean",
      "title": "Autoriza\u00e7\u00e3o de publica\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovado",
        "recusado"
      ],
      "default": "pendente",
      "title": "Status"
    },
    "data_envio": {
      "type": "string",
      "title": "Data de envio"
    }
  },
  "required": [
    "nome",
    "ano_conclusao",
    "curso",
    "autorizado"
  ]
}